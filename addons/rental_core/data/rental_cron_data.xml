<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Scheduled Action: Mark Overdue Orders -->
    <record id="ir_cron_rental_mark_overdue" model="ir.cron">
        <field name="name">Rental: Mark Overdue Orders</field>
        <field name="model_id" ref="rental_core.model_rental_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_mark_overdue()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- Scheduled Action: Send Return Reminders -->
    <record id="ir_cron_rental_send_return_reminders" model="ir.cron">
        <field name="name">Rental: Send Return Reminders</field>
        <field name="model_id" ref="rental_core.model_rental_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_return_reminders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
