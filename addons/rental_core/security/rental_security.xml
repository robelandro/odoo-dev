<odoo>
    <record model="ir.module.category" id="module_category_rental">
        <field name="name">Rental</field>
        <field name="description">Manage equipment rentals, orders, and maintenance.</field>
        <field name="sequence">25</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_rental">
        <field name="name">Rental</field>
        <field name="category_id" ref="module_category_rental"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_rental_user" model="res.groups">
        <field name="name">Staff</field>
        <field name="sequence">10</field>
        <field name="comment">Manage equipment, orders, and maintenance. Cannot delete records.</field>
        <field name="privilege_id" ref="res_groups_privilege_rental"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_rental_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="comment">Full access to manage all rental settings, equipment, and orders.</field>
        <field name="privilege_id" ref="res_groups_privilege_rental"/>
        <field name="implied_ids" eval="[(4, ref('group_rental_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
