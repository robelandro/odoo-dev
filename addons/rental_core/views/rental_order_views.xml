<odoo>
    <!-- List View -->
    <record id="rental_order_view_list" model="ir.ui.view">
        <field name="name">rental.order.view.list</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <list string="Rental Orders" decoration-info="state == 'draft'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="days"/>
                <field name="total" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'confirmed'"
                       decoration-warning="state == 'rented'"
                       decoration-danger="state == 'overdue'"
                       decoration-success="state == 'returned'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="rental_order_view_form" model="ir.ui.view">
        <field name="name">rental.order.view.form</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <form string="Rental Order">
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start_rental"
                            string="Start Rental"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_open_return_wizard"
                            string="Return"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['rented', 'overdue']"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state not in ['draft', 'confirmed']"/>
                    <button name="action_set_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,rented,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Rental Order</span>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" readonly="state != 'draft'"/>
                            <field name="user_id" readonly="state not in ['draft', 'confirmed']"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                            <field name="days"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipment Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="equipment_id"/>
                                    <field name="daily_price"/>
                                    <field name="days" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="rental_order_view_calendar" model="ir.ui.view">
        <field name="name">rental.order.view.calendar</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <calendar string="Rental Orders"
                      date_start="date_start"
                      date_stop="date_end"
                      color="state"
                      mode="month"
                      event_limit="5"
                      quick_create="0">
                <field name="name"/>
                <field name="customer_id" avatar_field="avatar_128"/>
                <field name="total" widget="monetary"/>
                <field name="state" filters="1"/>
            </calendar>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="rental_order_view_kanban" model="ir.ui.view">
        <field name="name">rental.order.view.kanban</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1" quick_create="false">
                <field name="currency_id"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'
                             sum_field="total"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center mb-1">
                            <field name="name" class="fw-bolder fs-5 me-2"/>
                            <field name="total" widget="monetary" class="fw-bolder ms-auto flex-shrink-0"/>
                        </div>
                        <div class="text-muted mb-1">
                            <field name="customer_id"/>
                        </div>
                        <div class="small text-muted mb-2">
                            <i class="fa fa-calendar me-1"/>
                            <field name="date_start"/> &#8594; <field name="date_end"/> (<field name="days"/> d)
                        </div>
                        <footer class="align-items-end pt-1">
                            <div class="d-flex flex-wrap gap-1 text-muted text-nowrap">
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-primary="state == 'confirmed'"
                                   decoration-warning="state == 'rented'"
                                   decoration-danger="state == 'overdue'"
                                   decoration-success="state == 'returned'"
                                   decoration-muted="state == 'cancelled'"
                                   class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Graph View -->
    <record id="rental_order_view_graph" model="ir.ui.view">
        <field name="name">rental.order.view.graph</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <graph string="Rental Revenue Analysis" sample="1">
                <field name="date_start" interval="month"/>
                <field name="total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="rental_order_view_pivot" model="ir.ui.view">
        <field name="name">rental.order.view.pivot</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <pivot string="Rental Orders Analysis" sample="1">
                <field name="category_id" type="row"/>
                <field name="date_start" interval="month" type="col"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View -->
    <record id="rental_order_view_search" model="ir.ui.view">
        <field name="name">rental.order.view.search</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <search string="Search Rental Orders">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="category_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Rented" name="rented" domain="[('state', '=', 'rented')]"/>
                <filter string="Overdue" name="overdue" domain="[('state', '=', 'overdue')]"/>
                <filter string="Returned" name="returned" domain="[('state', '=', 'returned')]"/>
                <group>
                    <filter string="Customer" name="group_by_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Start Date" name="group_by_date_start" context="{'group_by': 'date_start'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window: Orders -->
    <record id="rental_order_action" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">rental.order</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="rental_order_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first rental order!
            </p>
        </field>
    </record>

    <!-- Action Window: Reporting -->
    <record id="rental_order_report_action" model="ir.actions.act_window">
        <field name="name">Rental Reporting</field>
        <field name="res_model">rental.order</field>
        <field name="view_mode">graph,pivot</field>
        <field name="search_view_id" ref="rental_order_view_search"/>
        <field name="context">{'search_default_confirmed': 1, 'search_default_rented': 1, 'search_default_returned': 1, 'search_default_overdue': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No rental revenue data yet!
            </p>
        </field>
    </record>
</odoo>
