<odoo>
    <record id="rental_category_view_list" model="ir.ui.view">
        <field name="name">rental.category.view.list</field>
        <field name="model">rental.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="rental_category_view_form" model="ir.ui.view">
        <field name="name">rental.category.view.form</field>
        <field name="model">rental.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Heavy Machinery"/></h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rental_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">rental.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first equipment category!
            </p>
        </field>
    </record>
</odoo>
