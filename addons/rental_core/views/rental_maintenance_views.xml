<odoo>
    <!-- List View -->
    <record id="rental_maintenance_view_list" model="ir.ui.view">
        <field name="name">rental.maintenance.view.list</field>
        <field name="model">rental.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance Requests" decoration-danger="state == 'todo'" decoration-success="state == 'done'">
                <field name="date"/>
                <field name="equipment_id"/>
                <field name="technician_id"/>
                <field name="cost"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'todo'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="rental_maintenance_view_form" model="ir.ui.view">
        <field name="name">rental.maintenance.view.form</field>
        <field name="model">rental.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <header>
                    <button name="action_mark_done"
                            string="Mark as Done"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_set_todo"
                            string="Re-open"
                            type="object"
                            invisible="state == 'todo'"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="technician_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="cost"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description &amp; Repair Work" name="desc">
                            <field name="description" placeholder="Describe the damage, diagnostic steps, or repair actions taken..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="rental_maintenance_view_search" model="ir.ui.view">
        <field name="name">rental.maintenance.view.search</field>
        <field name="model">rental.maintenance</field>
        <field name="arch" type="xml">
            <search string="Search Maintenance">
                <field name="equipment_id"/>
                <field name="technician_id"/>
                <separator/>
                <filter string="To Do" name="todo" domain="[('state', '=', 'todo')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Equipment" name="group_by_equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter string="Technician" name="group_by_technician" context="{'group_by': 'technician_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="rental_maintenance_action" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">rental.maintenance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="rental_maintenance_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No maintenance records currently registered.
            </p>
        </field>
    </record>
</odoo>
